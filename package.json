{
  "name": "@maxmusin/core-sdk",
  "version": "1.0.0",
  "description": "Core SDK for betting platform - API client, auth, and utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxMusin/betting-core-sdk.git"
  },
  "publishConfig": {
